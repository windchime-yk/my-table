{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mt.whyk.dev/schema/v1/event.schema.json",
  "title": "マイテーブル イベントデータ v1",
  "description": "1イベント1ファイル。イベント → 日 → ステージ → 枠 の4階層。時刻はイベントのタイムゾーンでの HH:MM で、日をまたぐ深夜帯は 24:30 のように24時以降で書く。",
  "type": "object",
  "required": ["schema_version", "id", "visibility", "event", "days"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "エディタ補完用。このスキーマの URL を書く",
      "type": "string"
    },
    "schema_version": {
      "description": "スキーマのバージョン",
      "const": "1"
    },
    "id": {
      "description": "イベントID。ファイル名と揃える。URL（/e/<id>）になる",
      "$ref": "#/$defs/slug"
    },
    "visibility": {
      "description": "public はサイトに含める。private はビルドから除外する",
      "enum": ["public", "private"]
    },
    "event": { "$ref": "#/$defs/eventInfo" },
    "tag_definitions": {
      "description": "タグのキーと表示名。例: { \"no_photo\": \"撮影禁止\" }",
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/text" }
    },
    "days": {
      "description": "開催日。1日以上",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/day" }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "optionalText": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "textList": {
      "type": "array",
      "items": { "$ref": "#/$defs/text" }
    },
    "date": {
      "description": "YYYY-MM-DD",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "description": "HH:MM。日をまたぐ深夜帯は 24:30 のように書く",
      "type": "string",
      "pattern": "^[0-4]\\d:[0-5]\\d$"
    },
    "optionalTime": {
      "type": ["string", "null"],
      "pattern": "^[0-4]\\d:[0-5]\\d$"
    },
    "eventInfo": {
      "type": "object",
      "required": ["name", "timezone"],
      "additionalProperties": false,
      "properties": {
        "name": { "description": "イベント名", "$ref": "#/$defs/text" },
        "venue": { "description": "会場", "$ref": "#/$defs/optionalText" },
        "timezone": { "description": "IANA タイムゾーン（例: Asia/Tokyo）", "$ref": "#/$defs/text" },
        "official_url": { "description": "公式サイト", "$ref": "#/$defs/optionalText" },
        "sources": { "description": "取り込み元（公式タイムテーブル画像、公式告知など）の説明", "$ref": "#/$defs/textList" },
        "notice": { "description": "公式の注意書き", "$ref": "#/$defs/optionalText" },
        "detail_url_base": {
          "description": "枠の detail を相対パスで書くときの基準 URL",
          "$ref": "#/$defs/optionalText"
        }
      }
    },
    "day": {
      "type": "object",
      "required": ["date", "stages"],
      "additionalProperties": false,
      "properties": {
        "date": { "$ref": "#/$defs/date" },
        "label": { "description": "表示名（例: DAY1）", "$ref": "#/$defs/optionalText" },
        "end_time": { "description": "終演時刻", "$ref": "#/$defs/optionalTime" },
        "day_events": {
          "description": "開場・休憩・懇親会など、選択の対象にしない時間帯",
          "type": "array",
          "items": { "$ref": "#/$defs/dayEvent" }
        },
        "stages": {
          "description": "ステージ。1つ以上",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stage" }
        }
      }
    },
    "dayEvent": {
      "type": "object",
      "required": ["start", "title", "kind"],
      "additionalProperties": false,
      "properties": {
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/optionalTime" },
        "title": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["doors", "break", "ceremony", "party", "setup", "close", "other"] },
        "stages": {
          "description": "対象のステージID。省略すると全ステージ共通",
          "type": "array",
          "items": { "$ref": "#/$defs/text" }
        }
      }
    },
    "stage": {
      "type": "object",
      "required": ["id", "name", "slots"],
      "additionalProperties": false,
      "properties": {
        "id": { "description": "日の中で一意", "$ref": "#/$defs/text" },
        "name": { "$ref": "#/$defs/text" },
        "color": { "description": "表示色（CSS の色。OKLCH 推奨）", "$ref": "#/$defs/optionalText" },
        "hashtag": { "$ref": "#/$defs/optionalText" },
        "closed": {
          "description": "ステージが閉まっている時間帯",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["start", "end"],
            "additionalProperties": false,
            "properties": {
              "start": { "$ref": "#/$defs/time" },
              "end": { "$ref": "#/$defs/time" }
            }
          }
        },
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/slot" }
        }
      }
    },
    "slot": {
      "type": "object",
      "required": ["id", "start", "end", "end_source", "title", "category"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "イベント内で一意（items の id とも重複しない）。一度公開したら時刻が変わっても変えない",
          "$ref": "#/$defs/text"
        },
        "start": { "$ref": "#/$defs/time" },
        "end": { "$ref": "#/$defs/time" },
        "end_source": {
          "description": "終了時刻の根拠。explicit 公式に記載 / next_slot 次の枠と連続 / inferred 推定 / day_end 終演時刻から",
          "enum": ["explicit", "next_slot", "inferred", "day_end"]
        },
        "title": {
          "description": "枠の名前。items がない枠では必須（null 不可）",
          "$ref": "#/$defs/optionalText"
        },
        "category": { "enum": ["performance", "talk", "keynote", "workshop", "ceremony", "other"] },
        "kind_label": { "description": "元の表記（LIVE、DJ、10分セッションなど）", "$ref": "#/$defs/optionalText" },
        "speakers": { "description": "出演者・登壇者", "$ref": "#/$defs/textList" },
        "note": { "description": "補足（ゲスト、押しの情報など）", "$ref": "#/$defs/optionalText" },
        "subtitle": { "$ref": "#/$defs/optionalText" },
        "lang": { "description": "言語（ja、en など）", "$ref": "#/$defs/optionalText" },
        "tags": { "description": "tag_definitions に定義したキー", "$ref": "#/$defs/textList" },
        "simulcast_in": { "description": "同時中継先のステージID", "$ref": "#/$defs/textList" },
        "detail": {
          "description": "詳細ページの URL（または detail_url_base からの相対パス）",
          "$ref": "#/$defs/optionalText"
        },
        "external_url": { "description": "外部申込などの URL", "$ref": "#/$defs/optionalText" },
        "items": {
          "description": "1つの枠に、個別の開始時刻なしで複数のトークが入る場合のトーク一覧",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/item" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "description": "イベント内で一意", "$ref": "#/$defs/text" },
        "title": { "$ref": "#/$defs/text" },
        "speakers": { "$ref": "#/$defs/textList" },
        "detail": { "$ref": "#/$defs/optionalText" }
      }
    }
  }
}
